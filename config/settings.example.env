# config/settings.env 로 복사해서 값을 채우세요. 환경변수가 있으면 그쪽이 우선합니다.
# 이 파일(settings.env)은 토큰을 담으므로 절대 공유·커밋하지 마세요.

# ── 수집 ────────────────────────────────────────────────
RSS_URL=https://www.socialimpactnews.net/rss/allArticle.xml
ARTICLE_COUNT=10
# 수집 건수가 이 값 미만이면 실패로 처리하고 발행을 중단합니다.
MIN_ARTICLES=1

# ── AI 요약 ─────────────────────────────────────────────
# anthropic(기본) | rule(API 없이 추출식 요약)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
BODY_CARD_COUNT=3

# ── 브랜드/디자인 (색상은 소임뉴 로고에서 추출) ────────────
BRAND_NAME=소셜임팩트뉴스
BRAND_EMAIL=press@soimnews.net
BRAND_HANDLE=@soimnews
BRAND_COLOR=#00A76B
ACCENT_COLOR=#89F394
INK_COLOR=#3C3C3C
PAPER_COLOR=#FBFCFB
LOGO_PATH=소임뉴2.png

# ── 기관 계정 태그 ──────────────────────────────────────
# 태그는 카드 이미지에 찍지 않고 업로드 시 user_tags로 붙습니다.
# 캡션에도 @멘션을 남기고 싶으면 true (기본 false)
CAPTION_MENTIONS=false
# 매핑에 없는 기관을 웹 검색으로 찾아 자동 등록할지 (ANTHROPIC_API_KEY 필요)
ACCOUNT_AUTO_RESOLVE=true
ACCOUNT_RESOLVE_BUDGET=6
ACCOUNT_RESOLVE_MODEL=claude-opus-5

# ── 커버 문구 덮어쓰기 ──────────────────────────────────
# 편집자가 손으로 적은 헤드라인·훅이 있으면 무엇으로 만들었든 그것이 최종본이 됩니다.
# 파일이 없으면 덮어쓰기 없이 그대로 돕니다. 만드는 법은 README 5장 참고.
OVERRIDES_PATH=config/overrides.csv

# ── 기사 전문으로 보내기 ────────────────────────────────
# 인스타그램 캡션의 URL은 클릭되지 않습니다. 프로필 바이오에 걸 링크 페이지를 자동 생성해
# out/linkinbio/ 에 만들어 두므로, 정적 호스팅에 올린 뒤 그 주소를 여기에 적고 바이오에 거세요.
LINK_CTA=프로필 링크에서 기사 전문 보기
LINKINBIO_BASE_URL=
LINKINBIO_LIMIT=12

# ── 발행 ────────────────────────────────────────────────
# graph(Instagram Graph API) | webhook(Make/Zapier 중계) | console(출력만)
PUBLISHER=graph
IG_PUBLISH_TARGET=carousel
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=v21.0
# Graph API는 공개 URL로만 이미지를 받습니다. out/ 디렉터리를 정적 호스팅한 주소를 넣으세요.
# 예) https://cdn.example.com/cardnews  → https://cdn.example.com/cardnews/run-.../SIN6833_01.png
PUBLIC_IMAGE_BASE_URL=
PUBLISH_DELAY_SECONDS=5
PUBLISH_WEBHOOK_URL=

# ── 알림 ────────────────────────────────────────────────
# 실행 실패 시 POST를 받을 주소(Slack Incoming Webhook 등). 비우면 알림을 보내지 않습니다.
ALERT_WEBHOOK_URL=
